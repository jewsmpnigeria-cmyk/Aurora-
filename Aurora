function Tab:CreateColorPicker(o)
	local w = self.Window
	o = o or {}
	local color = o.Default or Color3.fromRGB(255, 255, 255)
	local h, s, v = color:ToHSV()

	local hh = self:_height(o)
	local el = self:_element(hh)
	el.ClipsDescendants = true
	self:_head(el, o, 70)

	local swatch = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = rightPos(hh, 14),
		Size = UDim2.fromOffset(36, 20),
		BorderSizePixel = 0,
		Parent = el,
	})
	corner(swatch, 6)
	w:_stroke(swatch)

	local headHit = w:_hit(el)
	headHit.Size = UDim2.new(1, 0, 0, hh)
	w:_hover(el, headHit)

	local svBox = create("Frame", {
		Position = UDim2.fromOffset(14, hh + 8),
		Size = UDim2.new(1, -28, 0, 100),
		BorderSizePixel = 0,
		Parent = el,
	})
	corner(svBox, 8)
	local white = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = svBox,
	})
	corner(white, 8)
	create("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
	local black = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = svBox,
	})
	corner(black, 8)
	create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
	local svKnob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = svBox,
	})
	corner(svKnob, 100)
	create("UIStroke", { Thickness = 2, Color = Color3.new(0, 0, 0), Parent = svKnob })
	local svHit = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = svBox,
	})

	local hueBar = create("Frame", {
		Position = UDim2.fromOffset(14, hh + 116),
		Size = UDim2.new(1, -28, 0, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = el,
	})
	corner(hueBar, 100)
	local kps = {}
	for i = 0, 6 do
		table.insert(kps, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((i / 6) % 1, 1, 1)))
	end
	create("UIGradient", { Color = ColorSequence.new(kps), Parent = hueBar })
	local hueKnob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(8, 18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = hueBar,
	})
	corner(hueKnob, 4)
	create("UIStroke", { Thickness = 2, Color = Color3.new(0, 0, 0), Parent = hueKnob })
	local hueHit = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = hueBar,
	})

	local function paint()
		swatch.BackgroundColor3 = color
		svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svKnob.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
	end
	paint()

	local mode
	local function update(pos)
		if mode == "sv" then
			s = math.clamp((pos.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
			v = 1 - math.clamp((pos.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
		elseif mode == "hue" then
			h = math.clamp((pos.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 0.999)
		end
		color = Color3.fromHSV(h, s, v)
		paint()
		fire(o.Callback, color)
	end
	svHit.InputBegan:Connect(function(input)
		if isPress(input) then
			mode = "sv"
			update(input.Position)
		end
	end)
	hueHit.InputBegan:Connect(function(input)
		if isPress(input) then
			mode = "hue"
			update(input.Position)
		end
	end)
	w:_connect(UserInputService.InputChanged, function(input)
		if mode and isMove(input) then
			update(input.Position)
		end
	end)
	w:_connect(UserInputService.InputEnded, function(input)
		if mode and isPress(input) then
			mode = nil
		end
	end)

	local open = false
	headHit.MouseButton1Click:Connect(function()
		open = not open
		tween(el, { Size = UDim2.new(1, 0, 0, open and (hh + 140) or hh) }, 0.25)
	end)

	local obj = { Type = "ColorPicker" }
	function obj:Get()
		return color
	end
	function obj:Set(c, silent)
		color = c
		h, s, v = c:ToHSV()
		paint()
		if not silent then
			fire(o.Callback, color)
		end
	end
	w:_flag(o.Flag, obj)
	task.defer(fire, o.Callback, color)
	return finish(obj, el)
end

