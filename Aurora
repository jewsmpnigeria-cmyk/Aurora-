--// Helpers --------------------------------------------------------------------
local function copy(t)
	local n = {}
	for k, v in pairs(t) do
		n[k] = v
	end
	return n
end

local function tween(obj, props, t, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function create(class, props)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end

local function corner(parent, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r), Parent = parent })
end

local function pad(parent, t, r, b, l)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r),
		PaddingBottom = UDim.new(0, b),
		PaddingLeft = UDim.new(0, l),
		Parent = parent,
	})
end

local function fire(cb, ...)
	if type(cb) ~= "function" then
		return
	end
	task.spawn(function(...)
		local ok, err = pcall(cb, ...)
		if not ok then
			warn("[Aurora] callback error: " .. tostring(err))
		end
	end, ...)
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function finish(obj, el)
	function obj:Destroy()
		el:Destroy()
	end
	function obj:SetVisible(v)
		el.Visible = v
	end
	return obj
end

--// Window ---------------------------------------------------------------------
local Window = {}
Window.__index = Window
local Tab = {}
Tab.__index = Tab

function Window:_bind(inst, prop, key)
	inst[prop] = self.Theme[key]
	table.insert(self._themed, { inst, prop, key })
	return inst
end

function Window:_onTheme(inst, fn)
	table.insert(self._callbacks, { inst, fn })
end

function Window:_applyTheme(t)
	local alive = {}
	for _, b in ipairs(self._themed) do
		if b[1].Parent then
			table.insert(alive, b)
			tween(b[1], { [b[2]] = self.Theme[b[3]] }, t)
		end
	end
	self._themed = alive

	local cbs = {}
	for _, c in ipairs(self._callbacks) do
		if c[1].Parent then
			table.insert(cbs, c)
			c[2]()
		end
	end
	self._callbacks = cbs
end

function Window:_connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

function Window:_text(parent, text, size, key, font)
	local l = create("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size or 14,
		Font = font or Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
	self:_bind(l, "TextColor3", key or "Text")
	return l
end

function Window:_stroke(parent, key)
	local s = create("UIStroke", {
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
	self:_bind(s, "Color", key or "Stroke")
	return s
end

function Window:_hit(parent)
	return create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = parent,
	})
end

function Window:_hover(frame, trigger)
	trigger = trigger or frame
	trigger.MouseEnter:Connect(function()
		tween(frame, { BackgroundColor3 = self.Theme.ElementHover }, 0.15)
	end)
	trigger.MouseLeave:Connect(function()
		tween(frame, { BackgroundColor3 = self.Theme.Element }, 0.15)
	end)
end

function Window:_flag(name, obj)
	if name then
		self.Flags[name] = obj
	end
end

function Aurora:CreateWindow(opts)
	opts = opts or {}

	local theme
	local themeName = "Dark"
	if type(opts.Theme) == "table" then
		theme = copy(Aurora.Themes.Dark)
		for k, v in pairs(opts.Theme) do
			theme[k] = v
		end
		themeName = "Custom"
	else
		themeName = Aurora.Themes[opts.Theme or "Dark"] and (opts.Theme or "Dark") or "Dark"
		theme = copy(Aurora.Themes[themeName])
	end

	local self = setmetatable({
		Theme = theme,
		ThemeName = themeName,
		Flags = {},
		Tabs = {},
		Visible = true,
		Minimized = false,
		_themed = {},
		_callbacks = {},
		_conns = {},
		_notifOrder = 0,
		_toggleKey = opts.ToggleKey or Enum.KeyCode.RightShift,
	}, Window)

	local parent = resolveParent(opts.Parent)
	local guiName = "Aurora_" .. tostring(opts.Name or "UI")

	-- Re-running a script replaces the old window instead of stacking a second one
	local previous = Aurora._active[guiName]
	if previous then
		previous:Destroy(true)
	end
	Aurora._active[guiName] = self

	local folderName = tostring(opts.ConfigFolder or ("Aurora/" .. tostring(opts.Name or "UI")))
	self._configFolder = (folderName:gsub("[^%w_%-/ ]", "_"))

	local gui = create("ScreenGui", {
		Name = guiName,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100,
		Parent = parent,
	})
	self.Gui = gui
	gui.Destroying:Connect(function()
		for _, c in ipairs(self._conns) do
			c:Disconnect()
		end
		self._conns = {}
		if Aurora._active[guiName] == self then
			Aurora._active[guiName] = nil
		end
	end)

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local width = math.min(opts.Size and opts.Size.X or 580, vp.X - 24)
	local height = math.min(opts.Size and opts.Size.Y or 380, vp.Y - 24)
	self._width, self._height = width, height

	--// Main
	local main = create("CanvasGroup", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = gui,
	})
	self:_bind(main, "BackgroundColor3", "Background")
	corner(main, 12)
	self:_stroke(main)
	local uiScale = create("UIScale", { Scale = 0.92, Parent = main })
	self.Main = main
	self._scale = uiScale

	--// Topbar
	local topbar = create("Frame", { Size = UDim2.new(1, 0, 0, 44), BorderSizePixel = 0, Parent = main })
	self:_bind(topbar, "BackgroundColor3", "Sidebar")

	local dot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(8, 8),
		BorderSizePixel = 0,
		Parent = topbar,
	})
	self:_bind(dot, "BackgroundColor3", "Accent")
	corner(dot, 100)

	local title = self:_text(topbar, opts.Name or "Aurora", 15, "Text", Enum.Font.GothamBold)
	if opts.Subtitle then
		title.Position = UDim2.fromOffset(34, 6)
		title.Size = UDim2.new(0.6, 0, 0, 18)
		local sub = self:_text(topbar, opts.Subtitle, 11, "SubText")
		sub.Position = UDim2.fromOffset(34, 23)
		sub.Size = UDim2.new(0.6, 0, 0, 14)
	else
		title.Position = UDim2.fromOffset(34, 0)
		title.Size = UDim2.new(0.6, 0, 1, 0)
	end

	local function topButton(txt, x, hoverColor)
		local b = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, x, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundTransparency = 1,
			Text = txt,
			TextSize = 20,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			Parent = topbar,
		})
		self:_bind(b, "TextColor3", "SubText")
		b.MouseEnter:Connect(function()
			tween(b, { TextColor3 = hoverColor or self.Theme.Text }, 0.15)
		end)
		b.MouseLeave:Connect(function()
			tween(b, { TextColor3 = self.Theme.SubText }, 0.15)
		end)
		return b
	end
	local closeBtn = topButton("×", -10, Color3.fromRGB(240, 90, 100))
	local minBtn = topButton("–", -40)
	closeBtn.MouseButton1Click:Connect(function()
		self:Destroy()
	end)
	minBtn.MouseButton1Click:Connect(function()
		self:Minimize()
	end)

	local div = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		Parent = topbar,
	})
	self:_bind(div, "BackgroundColor3", "Stroke")

	--// Body
	local body = create("Frame", {
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -44),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = main,
	})
	self._body = body

	local sbw = width < 480 and 112 or 150
	local sidebar = create("Frame", { Size = UDim2.new(0, sbw, 1, 0), BorderSizePixel = 0, Parent = body })
	self:_bind(sidebar, "BackgroundColor3", "Sidebar")
	local sdiv = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BorderSizePixel = 0,
		Parent = sidebar,
	})
	self:_bind(sdiv, "BackgroundColor3", "Stroke")

	local tabList = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = sidebar,
	})
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabList })
	pad(tabList, 10, 10, 10, 10)
	self._tabList = tabList

	local content = create("Frame", {
		Position = UDim2.fromOffset(sbw, 0),
		Size = UDim2.new(1, -sbw, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = body,
	})
	self._content = content

	--// Dragging
	local dragging, dragStart, startPos
	topbar.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	self:_connect(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then
			local d = input.Position - dragStart
			tween(main, {
				Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + d.X,
					startPos.Y.Scale,
					startPos.Y.Offset + d.Y
				),
			}, 0.08)
		end
	end)

	--// Toggle key
	self:_connect(UserInputService.InputBegan, function(input, gp)
		if not gp and input.KeyCode == self._toggleKey then
			self:SetVisible(not self.Visible)
		end
	end)

	--// Notifications holder
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 300, 1, -32),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Parent = holder,
	})
	self._notifHolder = holder

	--// Mobile button
	if opts.MobileButton ~= false and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local mb = create("TextButton", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 14, 0.5, 0),
			Size = UDim2.fromOffset(42, 42),
			Text = "☰",
			TextSize = 20,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Parent = gui,
		})
		self:_bind(mb, "BackgroundColor3", "Sidebar")
		self:_bind(mb, "TextColor3", "Accent")
		corner(mb, 100)
		self:_stroke(mb)
		mb.MouseButton1Click:Connect(function()
			self:SetVisible(not self.Visible)
		end)
	end

	--// Intro animation
	tween(uiScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
	tween(main, { GroupTransparency = 0 }, 0.3)

	return self
end

--// Window API -----------------------------------------------------------------
function Window:SetVisible(v)
	self.Visible = v
	if v then
		self.Main.Visible = true
		tween(self._scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
		tween(self.Main, { GroupTransparency = 0 }, 0.25)
	else
		tween(self._scale, { Scale = 0.94 }, 0.2)
		tween(self.Main, { GroupTransparency = 1 }, 0.2)
		task.delay(0.2, function()
			if not self.Visible then
				self.Main.Visible = false
			end
		end)
	end
end

function Window:Toggle()
	self:SetVisible(not self.Visible)
end

function Window:SetToggleKey(key)
	self._toggleKey = key
end

function Window:Minimize(v)
	if v == nil then
		v = not self.Minimized
	end
	self.Minimized = v
	if v then
		tween(self.Main, { Size = UDim2.fromOffset(self._width, 44) }, 0.3)
		task.delay(0.3, function()
			if self.Minimized then
				self._body.Visible = false
			end
		end)
	else
		self._body.Visible = true
		tween(self.Main, { Size = UDim2.fromOffset(self._width, self._height) }, 0.3)
	end
end

function Window:SetTheme(theme)
	local new = copy(self.Theme)
	if type(theme) == "string" then
		assert(Aurora.Themes[theme], "[Aurora] Unknown theme: " .. theme)
		for k, v in pairs(Aurora.Themes[theme]) do
			new[k] = v
		end
		self.ThemeName = theme
	else
		for k, v in pairs(theme) do
			new[k] = v
		end
		self.ThemeName = "Custom"
	end
	self.Theme = new
	self:_applyTheme(0.35)
end

function Window:SetAccent(color)
	local new = copy(self.Theme)
	new.Accent = color
	self.Theme = new
	self:_applyTheme(0.25)
end

function Window:Destroy(instant)
	for _, c in ipairs(self._conns) do
		c:Disconnect()
	end
	self._conns = {}
	if instant then
		self.Gui:Destroy()
		return
	end
	tween(self.Main, { GroupTransparency = 1 }, 0.2)
	tween(self._scale, { Scale = 0.9 }, 0.2)
	task.delay(0.22, function()
		self.Gui:Destroy()
	end)
end

function Window:Notify(o)
	o = o or {}
	local dur = o.Duration or 4
	self._notifOrder = self._notifOrder + 1

	local wrap = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = self._notifOrder,
		Parent = self._notifHolder,
	})
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(330, 0),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = wrap,
	})
	self:_bind(card, "BackgroundColor3", "Element")
	corner(card, 10)
	self:_stroke(card)

	local inner = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	})
	pad(inner, 12, 14, 14, 14)
	create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner })

	local t = self:_text(inner, o.Title or "Notification", 14, "Text", Enum.Font.GothamBold)
	t.Size = UDim2.new(1, 0, 0, 0)
	t.AutomaticSize = Enum.AutomaticSize.Y
	t.TextWrapped = true
	t.LayoutOrder = 1
	if o.Content then
		local c = self:_text(inner, o.Content, 13, "SubText")
		c.Size = UDim2.new(1, 0, 0, 0)
		c.AutomaticSize = Enum.AutomaticSize.Y
		c.TextWrapped = true
		c.LayoutOrder = 2
	end

	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BorderSizePixel = 0,
		Parent = card,
	})
	self:_bind(bar, "BackgroundColor3", "Accent")

	tween(card, { Position = UDim2.fromOffset(0, 0) }, 0.4)
	tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, dur, Enum.EasingStyle.Linear)

	task.delay(dur, function()
		if card.Parent then
			tween(card, { Position = UDim2.fromOffset(330, 0) }, 0.3)
			task.delay(0.32, function()
				wrap:Destroy()
			end)
		end
	end)
end

function Window:GetFlag(name)
	local o = self.Flags[name]
	return o and o:Get()
end

function Window:GetConfig()
	local cfg = {}
	for name, obj in pairs(self.Flags) do
		local v = obj:Get()
		if typeof(v) == "Color3" then
			v = { __color = { v.R, v.G, v.B } }
		elseif typeof(v) == "EnumItem" then
			v = { __key = v.Name }
		end
		cfg[name] = v
	end
	return cfg
end

function Window:LoadConfig(cfg)
	for name, v in pairs(cfg) do
		local obj = self.Flags[name]
		if obj then
			if type(v) == "table" and v.__color then
				v = Color3.new(table.unpack(v.__color))
			elseif type(v) == "table" and v.__key then
				v = Enum.KeyCode[v.__key]
			end
			obj:Set(v)
		end
	end
end

--// File configs (only work where writefile/readfile exist, e.g. executors) --------
local function cleanName(name)
	return (tostring(name or "default"):gsub("[^%w_%- ]", "_"))
end

function Window:CanSaveFiles()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

function Window:SaveConfig(name)
	if not self:CanSaveFiles() then
		return false, "This environment has no file functions (writefile/readfile)."
	end
	local ok, err = pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" then
			local path = ""
			for part in string.gmatch(self._configFolder, "[^/]+") do
				path = path == "" and part or (path .. "/" .. part)
				if not isfolder(path) then
					makefolder(path)
				end
			end
		end
		writefile(self._configFolder .. "/" .. cleanName(name) .. ".json", HttpService:JSONEncode(self:GetConfig()))
	end)
	return ok, ok and nil or tostring(err)
end

function Window:LoadConfigFile(name)
	if not self:CanSaveFiles() then
		return false, "This environment has no file functions (writefile/readfile)."
	end
	local path = self._configFolder .. "/" .. cleanName(name) .. ".json"
	if not isfile(path) then
		return false, "Config not found: " .. cleanName(name)
	end
	local ok, err = pcall(function()
		self:LoadConfig(HttpService:JSONDecode(readfile(path)))
	end)
	return ok, ok and nil or tostring(err)
end

function Window:ListConfigs()
	local out = {}
	if type(listfiles) ~= "function" or type(isfolder) ~= "function" or not isfolder(self._configFolder) then
		return out
	end
	local ok, files = pcall(listfiles, self._configFolder)
	if ok then
		for _, f in ipairs(files) do
			local n = tostring(f):match("([^/\\]+)%.json$")
			if n then
				table.insert(out, n)
			end
		end
	end
	table.sort(out)
	return out
end

--// Tabs -----------------------------------------------------------------------
function Window:SelectTab(tab)
	for _, t in ipairs(self.Tabs) do
		t:_setActive(t == tab)
	end
end

function Window:CreateTab(name, icon)
	local w = self
	local tab = setmetatable({ Window = w, _order = 0, _active = false }, Tab)

	local btn = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 34),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		LayoutOrder = #w.Tabs + 1,
		Parent = w._tabList,
	})
	w:_bind(btn, "BackgroundColor3", "Element")
	corner(btn, 8)

	local indicator = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(3, 0),
		BorderSizePixel = 0,
		Parent = btn,
	})
	w:_bind(indicator, "BackgroundColor3", "Accent")
	corner(indicator, 100)

	local label = create("TextLabel", {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -18, 1, 0),
		BackgroundTransparency = 1,
		Text = (icon and (icon .. "  ") or "") .. name,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = w.Theme.SubText,
		Parent = btn,
	})

	local page = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = w._content,
	})
	w:_bind(page, "ScrollBarImageColor3", "Accent")
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
	pad(page, 12, 14, 12, 12)

	tab.Button, tab.Label, tab.Indicator, tab.Page = btn, label, indicator, page

	function tab:_render(t)
		local th = w.Theme
		tween(label, { TextColor3 = self._active and th.Text or th.SubText }, t)
		tween(btn, { BackgroundTransparency = self._active and 0 or 1 }, t)
		tween(indicator, { Size = UDim2.fromOffset(3, self._active and 18 or 0) }, t)
	end

	function tab:_setActive(active)
		local changed = self._active ~= active
		self._active = active
		page.Visible = active
		if active and changed then
			page.Position = UDim2.fromOffset(0, 14)
			tween(page, { Position = UDim2.fromOffset(0, 0) }, 0.35)
		end
		self:_render(0.2)
	end

	w:_onTheme(btn, function()
		tab:_render(0.3)
	end)

	btn.MouseEnter:Connect(function()
		if not tab._active then
			tween(label, { TextColor3 = w.Theme.Text }, 0.15)
		end
	end)
	btn.MouseLeave:Connect(function()
		tab:_render(0.15)
	end)
	btn.MouseButton1Click:Connect(function()
		w:SelectTab(tab)
	end)

	table.insert(w.Tabs, tab)
	if #w.Tabs == 1 then
		w:SelectTab(tab)
	end
	return tab
end

