--// Helpers --------------------------------------------------------------------
local function resolveParent(custom)
	if custom then
		return custom
	end
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and typeof(hui) == "Instance" then
		return hui
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function copy(t)
	local n = {}
	for k, v in pairs(t) do
		n[k] = v
	end
	return n
end

local function textOn(c)
	local l = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return l > 0.6 and Color3.fromRGB(24, 14, 28) or Color3.new(1, 1, 1)
end

local function tween(obj, props, t, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function create(class, props)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end

local function corner(parent, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r), Parent = parent })
end

local function pad(parent, t, r, b, l)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r),
		PaddingBottom = UDim.new(0, b),
		PaddingLeft = UDim.new(0, l),
		Parent = parent,
	})
end

local function fire(cb, ...)
	if type(cb) ~= "function" then
		return
	end
	task.spawn(function(...)
		local ok, err = pcall(cb, ...)
		if not ok then
			warn("[Aurora] callback error: " .. tostring(err))
		end
	end, ...)
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function finish(obj, el)
	function obj:Destroy()
		el:Destroy()
	end
	function obj:SetVisible(v)
		el.Visible = v
	end
	return obj
end

local function snapper(min, max, inc)
	local dec = tostring(inc):match("%.(%d+)")
	dec = dec and #dec or 0
	return function(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		return tonumber(string.format("%." .. dec .. "f", v))
	end, dec
end

-- Builds an icon from an asset id/url (image) or any text glyph. Returns instance, colorProperty.
local function makeIcon(ic, size, parent)
	if type(ic) == "number" then
		ic = "rbxassetid://" .. ic
	end
	local isImage = type(ic) == "string" and (ic:find("^rbxasset") ~= nil or ic:find("^http") ~= nil)
	if isImage then
		return create("ImageLabel", {
			BackgroundTransparency = 1,
			Image = ic,
			Size = UDim2.fromOffset(size, size),
			Parent = parent,
		}), "ImageColor3"
	end
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(ic),
		TextSize = size,
		Font = Enum.Font.GothamMedium,
		Size = UDim2.fromOffset(size + 4, size + 4),
		Parent = parent,
	}), "TextColor3"
end

--// Window ---------------------------------------------------------------------
local Window = {}
Window.__index = Window
local Tab = {}
Tab.__index = Tab

function Window:_bind(inst, prop, key)
	inst[prop] = self.Theme[key]
	table.insert(self._themed, { inst, prop, key })
	return inst
end

function Window:_onTheme(inst, fn)
	table.insert(self._callbacks, { inst, fn })
end

function Window:_applyTheme(t)
	local alive = {}
	for _, b in ipairs(self._themed) do
		if b[1].Parent then
			table.insert(alive, b)
			tween(b[1], { [b[2]] = self.Theme[b[3]] }, t)
		end
	end
	self._themed = alive

	local cbs = {}
	for _, c in ipairs(self._callbacks) do
		if c[1].Parent then
			table.insert(cbs, c)
			c[2]()
		end
	end
	self._callbacks = cbs
end

function Window:_connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

function Window:_text(parent, text, size, key, font)
	local l = create("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size or 14,
		Font = font or Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
	self:_bind(l, "TextColor3", key or "Text")
	return l
end

function Window:_stroke(parent, key)
	local s = create("UIStroke", {
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
	self:_bind(s, "Color", key or "Stroke")
	return s
end

function Window:_hit(parent)
	return create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = parent,
	})
end

function Window:_hover(frame, trigger)
	trigger = trigger or frame
	trigger.MouseEnter:Connect(function()
		tween(frame, { BackgroundColor3 = self.Theme.ElementHover }, 0.15)
	end)
	trigger.MouseLeave:Connect(function()
		tween(frame, { BackgroundColor3 = self.Theme.Element }, 0.15)
	end)
end

function Window:_flag(name, obj)
	if name then
		self.Flags[name] = obj
	end
end

function Window:_refreshHints()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local key = KEYNAMES[self._toggleKey.Name] or self._toggleKey.Name
	if self._hintChip then
		self._hintChip.Text = touch and "Tap" or key
	end
	if self._opener then
		self._opener.Text = touch and ("Tap to open " .. self._name) or (key .. " to open " .. self._name)
	end
end

function Aurora:CreateWindow(opts)
	opts = opts or {}

	local theme
	local themeName = "Plum"
	if type(opts.Theme) == "table" then
		theme = copy(Aurora.Themes.Plum)
		for k, v in pairs(opts.Theme) do
			theme[k] = v
		end
		if opts.Theme.Accent and not opts.Theme.AccentText then
			theme.AccentText = textOn(opts.Theme.Accent)
		end
		themeName = "Custom"
	else
		themeName = Aurora.Themes[opts.Theme or "Plum"] and (opts.Theme or "Plum") or "Plum"
		theme = copy(Aurora.Themes[themeName])
	end

	local self = setmetatable({
		Theme = theme,
		ThemeName = themeName,
		Flags = {},
		Tabs = {},
		Visible = true,
		_name = tostring(opts.Name or "Aurora"),
		_themed = {},
		_callbacks = {},
		_conns = {},
		_notifOrder = 0,
		_toggleKey = opts.ToggleKey or Enum.KeyCode.RightShift,
	}, Window)

	local parent = resolveParent(opts.Parent)
	local guiName = "Aurora_" .. self._name

	-- Re-running a script replaces the old window instead of stacking a second one
	local previous = Aurora._active[guiName]
	if previous then
		previous:Destroy(true)
	end
	Aurora._active[guiName] = self

	local folderName = tostring(opts.ConfigFolder or ("Aurora/" .. self._name))
	self._configFolder = (folderName:gsub("[^%w_%-/ ]", "_"))

	local gui = create("ScreenGui", {
		Name = guiName,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100,
		Parent = parent,
	})
	self.Gui = gui
	gui.Destroying:Connect(function()
		for _, c in ipairs(self._conns) do
			c:Disconnect()
		end
		self._conns = {}
		if Aurora._active[guiName] == self then
			Aurora._active[guiName] = nil
		end
	end)

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local width = math.min(opts.Size and opts.Size.X or 640, vp.X - 24)
	local height = math.min(opts.Size and opts.Size.Y or 470, vp.Y - 24)
	self._width, self._height = width, height
	local sbw = width < 540 and 132 or 172

	--// Main window
	local main = create("CanvasGroup", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = gui,
	})
	self:_bind(main, "BackgroundColor3", "Background")
	corner(main, 14)
	self:_stroke(main)
	local uiScale = create("UIScale", { Scale = 0.92, Parent = main })
	self.Main = main
	self._scale = uiScale

	-- soft accent glow in the bottom-left corner
	local glow = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		Parent = main,
	})
	self:_bind(glow, "BackgroundColor3", "Accent")
	create("UIGradient", { Rotation = 135, Transparency = NumberSequence.new(1, 0.86), Parent = glow })

	-- drag zone across the top
	local dragZone = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 70),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = main,
	})

	--// Logo block
	local logoX = 20
	if opts.Icon then
		local ic, prop = makeIcon(opts.Icon, 26, main)
		ic.Position = UDim2.fromOffset(20, 18)
		self:_bind(ic, prop, "Accent")
		logoX = 56
	else
		local g = self:_text(main, "✦", 24, "Accent", Enum.Font.GothamBold)
		g.Position = UDim2.fromOffset(20, 16)
		g.Size = UDim2.fromOffset(28, 30)
		g.TextXAlignment = Enum.TextXAlignment.Center
		logoX = 56
	end
	local logoTitle = self:_text(main, self._name, 15, "Text", Enum.Font.GothamBold)
	logoTitle.Position = UDim2.fromOffset(logoX, 16)
	logoTitle.Size = UDim2.fromOffset(sbw - logoX - 8, 18)
	logoTitle.TextTruncate = Enum.TextTruncate.AtEnd
	local logoSub = self:_text(main, opts.Subtitle or "", 12, "SubText")
	logoSub.Position = UDim2.fromOffset(logoX, 35)
	logoSub.Size = UDim2.fromOffset(sbw - logoX - 8, 14)
	logoSub.TextTruncate = Enum.TextTruncate.AtEnd

	--// Sidebar divider
	local sdiv = create("Frame", {
		Position = UDim2.new(0, sbw, 0, 22),
		Size = UDim2.new(0, 1, 1, -44),
		BorderSizePixel = 0,
		Parent = main,
	})
	self:_bind(sdiv, "BackgroundColor3", "Stroke")

	--// Tab list
	local tabList = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(0, sbw, 1, -142),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = main,
	})
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabList })
	pad(tabList, 4, 12, 4, 12)
	self._tabList = tabList

	--// Hide hint (text, bottom-left)
	local hint = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(sbw - 24, 26),
		BackgroundTransparency = 1,
		Parent = main,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = hint,
	})
	local chip = create("TextLabel", {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		Text = "",
		TextSize = 11,
		Font = Enum.Font.GothamMedium,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Parent = hint,
	})
	self:_bind(chip, "BackgroundColor3", "Element")
	self:_bind(chip, "TextColor3", "SubText")
	corner(chip, 6)
	self:_stroke(chip)
	pad(chip, 0, 8, 0, 8)
	local hintText = self:_text(hint, "to hide", 12, "SubText")
	hintText.AutomaticSize = Enum.AutomaticSize.X
	hintText.Size = UDim2.fromOffset(0, 22)
	hintText.LayoutOrder = 2
	local hintBtn = self:_hit(hint)
	hintBtn.MouseButton1Click:Connect(function()
		self:SetVisible(false)
	end)
	self._hintChip = chip

	--// Header
	local title = self:_text(main, "", 20, "Text", Enum.Font.GothamBold)
	title.Position = UDim2.fromOffset(sbw + 24, 16)
	title.Size = UDim2.new(1, -(sbw + 80), 0, 26)
	title.TextTruncate = Enum.TextTruncate.AtEnd
	local subtitle = self:_text(main, "", 12, "SubText")
	subtitle.Position = UDim2.fromOffset(sbw + 24, 44)
	subtitle.Size = UDim2.new(1, -(sbw + 80), 0, 14)
	subtitle.TextTruncate = Enum.TextTruncate.AtEnd
	self._title, self._subtitle = title, subtitle

	local closeBtn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		Text = "×",
		TextSize = 24,
		Font = Enum.Font.GothamMedium,
		AutoButtonColor = false,
		ZIndex = 5,
		Parent = main,
	})
	self:_bind(closeBtn, "TextColor3", "SubText")
	closeBtn.MouseEnter:Connect(function()
		tween(closeBtn, { TextColor3 = self.Theme.Text }, 0.15)
	end)
	closeBtn.MouseLeave:Connect(function()
		tween(closeBtn, { TextColor3 = self.Theme.SubText }, 0.15)
	end)
	closeBtn.MouseButton1Click:Connect(function()
		self:SetVisible(false)
	end)

	--// Content area
	local content = create("Frame", {
		Position = UDim2.fromOffset(sbw, 70),
		Size = UDim2.new(1, -sbw, 1, -70),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = main,
	})
	self._content = content

	--// Dragging
	local dragging, dragStart, startPos
	dragZone.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	self:_connect(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then
			local d = input.Position - dragStart
			tween(main, {
				Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + d.X,
					startPos.Y.Scale,
					startPos.Y.Offset + d.Y
				),
			}, 0.08)
		end
	end)

	--// Toggle key
	self:_connect(UserInputService.InputBegan, function(input, gp)
		if not gp and input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode == self._toggleKey then
			self:SetVisible(not self.Visible)
		end
	end)

	--// Text opener (shown while the window is hidden)
	if opts.Opener ~= false then
		local opener = create("TextButton", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 16, 1, -16),
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
			Visible = false,
			Parent = gui,
		})
		self:_bind(opener, "BackgroundColor3", "Element")
		self:_bind(opener, "TextColor3", "SubText")
		corner(opener, 100)
		self:_stroke(opener)
		pad(opener, 8, 14, 8, 14)
		opener.MouseEnter:Connect(function()
			tween(opener, { TextColor3 = self.Theme.Text }, 0.15)
		end)
		opener.MouseLeave:Connect(function()
			tween(opener, { TextColor3 = self.Theme.SubText }, 0.15)
		end)
		opener.MouseButton1Click:Connect(function()
			self:SetVisible(true)
		end)
		self._opener = opener
	end
