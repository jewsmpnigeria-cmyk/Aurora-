-- Picks where the ScreenGui goes. Executors that provide gethui() get it,
-- everything else (Studio, normal LocalScripts) uses PlayerGui.
local function resolveParent(custom)
	if custom then
		return custom
	end
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and typeof(hui) == "Instance" then
		return hui
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

