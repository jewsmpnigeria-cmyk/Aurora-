function Window:CreateSettingsTab(name, icon)
	local tab = self:CreateTab(name or "Settings", icon, "Theme, colors and interface")

	tab:CreateSection("Appearance")
	local names = {}
	for n in pairs(Aurora.Themes) do
		table.insert(names, n)
	end
	table.sort(names)
	tab:CreateDropdown({
		Name = "Theme",
		Description = "Switch the whole look instantly",
		Options = names,
		Default = self.ThemeName ~= "Custom" and self.ThemeName or nil,
		Callback = function(n)
			if n and n ~= self.ThemeName then
				self:SetTheme(n)
			end
		end,
	})
	tab:CreateColorPicker({
		Name = "Accent color",
		Description = "Buttons, sliders and highlights",
		Default = self.Theme.Accent,
		Callback = function(c)
			if c ~= self.Theme.Accent then
				self:SetAccent(c)
			end
		end,
	})

	tab:CreateSection("Interface")
	tab:CreateKeybind({
		Name = "Toggle key",
		Description = "Shows and hides the window",
		Default = self._toggleKey,
		Changed = function(k)
			self:SetToggleKey(k)
		end,
	})
	tab:CreateButton({
		Name = "Destroy UI",
		Description = "Removes the window completely",
		Callback = function()
			self:Destroy()
		end,
