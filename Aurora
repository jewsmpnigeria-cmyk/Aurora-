function Tab:CreateToggle(o)
	local w = self.Window
	o = o or {}
	local hh = self:_height(o)
	local el = self:_element(hh)
	self:_head(el, o, 84)

	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = rightPos(hh, 16),
		Size = UDim2.fromOffset(44, 24),
		BorderSizePixel = 0,
		Parent = el,
	})
	corner(track, 100)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(knob, 100)

	local hit = w:_hit(el)
	w:_hover(el, hit)

	local state = o.Default == true
	local function render(t)
		tween(track, { BackgroundColor3 = state and w.Theme.Accent or w.Theme.Stroke }, t)
		tween(knob, {
			Position = state and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = state and w.Theme.AccentText or w.Theme.SubText,
		}, t)
	end
	render(0)
	w:_onTheme(el, function()
		render(0.3)
	end)

	local obj = { Type = "Toggle" }
	function obj:Set(v, silent)
		state = v == true
		render(0.2)
		if not silent then
			fire(o.Callback, state)
		end
	end
	function obj:Get()
		return state
	end
	hit.MouseButton1Click:Connect(function()
		obj:Set(not state)
	end)

	w:_flag(o.Flag, obj)
	task.defer(fire, o.Callback, state)
	return finish(obj, el)
end

--// Slider ---------------------------------------------------------------------
function Tab:CreateSlider(o)
	local w = self.Window
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local suffix = o.Suffix or ""
	local round, dec = snapper(min, max, o.Increment or 1)

	local el = self:_element(66)
	local name = w:_text(el, o.Name or "Slider", 14)
	name.Position = UDim2.fromOffset(16, 11)
	name.Size = UDim2.new(0.6, 0, 0, 24)

	local box = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 11),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BorderSizePixel = 0,
		Parent = el,
	})
	w:_bind(box, "BackgroundColor3", "Background")
	corner(box, 6)
	w:_stroke(box)
	pad(box, 0, 10, 0, 10)
	local valueLabel = w:_text(box, "", 12, "Text")
	valueLabel.AutomaticSize = Enum.AutomaticSize.X
	valueLabel.Size = UDim2.fromOffset(0, 24)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Center

	local track = create("Frame", {
		Position = UDim2.new(0, 16, 1, -22),
		Size = UDim2.new(1, -32, 0, 6),
		BorderSizePixel = 0,
		Parent = el,
	})
	w:_bind(track, "BackgroundColor3", "Stroke")
	corner(track, 100)
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track })
	w:_bind(fill, "BackgroundColor3", "Accent")
	corner(fill, 100)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BorderSizePixel = 0,
		Parent = fill,
	})
	w:_bind(knob, "BackgroundColor3", "Accent")
	corner(knob, 100)
	local ring = create("UIStroke", { Thickness = 3, Parent = knob })
	w:_bind(ring, "Color", "Element")

	local hit = create("TextButton", {
		Position = UDim2.new(0, 16, 1, -34),
		Size = UDim2.new(1, -32, 0, 30),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = el,
	})

	local value = round(o.Default or min)
	local function render(t)
		local a = (max == min) and 0 or (value - min) / (max - min)
		tween(fill, { Size = UDim2.fromScale(a, 1) }, t or 0.12)
		valueLabel.Text = string.format("%." .. dec .. "f", value) .. suffix
	end
	render(0)

	local dragging = false
	local function fromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local nv = round(min + (max - min) * a)
		if nv ~= value then
			value = nv
			render()
			fire(o.Callback, value)
		end
	end
	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			tween(knob, { Size = UDim2.fromOffset(15, 15) }, 0.15)
			fromX(input.Position.X)
		end
	end)
	w:_connect(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then
			fromX(input.Position.X)
		end
	end)
	w:_connect(UserInputService.InputEnded, function(input)
		if dragging and isPress(input) then
			dragging = false
			tween(knob, { Size = UDim2.fromOffset(12, 12) }, 0.15)
		end
	end)

	local obj = { Type = "Slider" }
	function obj:Set(v, silent)
		value = round(v)
		render()
		if not silent then
			fire(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	w:_flag(o.Flag, obj)
	task.defer(fire, o.Callback, value)
	return finish(obj, el)
end

--// Stepper (− value +) --------------------------------------------------------
function Tab:CreateStepper(o)
	local w = self.Window
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local step = o.Step or 1
	local round, dec = snapper(min, max, step)

	local hh = self:_height(o)
	local el = self:_element(hh)
	self:_head(el, o, 130)

	local box = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = rightPos(hh, 14),
		Size = UDim2.fromOffset(96, 30),
		BorderSizePixel = 0,
		Parent = el,
	})
	w:_bind(box, "BackgroundColor3", "Background")
	corner(box, 8)
	w:_stroke(box)

	local function mkButton(txt, side)
		local b = create("TextButton", {
			AnchorPoint = Vector2.new(side, 0),
			Position = UDim2.new(side, 0, 0, 0),
			Size = UDim2.new(0, 30, 1, 0),
			BackgroundTransparency = 1,
			Text = txt,
			TextSize = 16,
			Font = Enum.Font.GothamMedium,
			AutoButtonColor = false,
			Parent = box,
		})
		w:_bind(b, "TextColor3", "SubText")
		b.MouseEnter:Connect(function()
			tween(b, { TextColor3 = w.Theme.Text }, 0.15)
		end)
		b.MouseLeave:Connect(function()
			tween(b, { TextColor3 = w.Theme.SubText }, 0.15)
		end)
		return b
	end
	local minus, plus = mkButton("−", 0), mkButton("+", 1)
	local label = w:_text(box, "", 13, "Text")
	label.Position = UDim2.fromOffset(30, 0)
	label.Size = UDim2.new(1, -60, 1, 0)
	label.TextXAlignment = Enum.TextXAlignment.Center

	local value = round(o.Default or min)
	local function render()
		label.Text = string.format("%." .. dec .. "f", value)
	end
	render()

	local obj = { Type = "Stepper" }
	function obj:Set(v, silent)
		value = round(v)
		render()
		if not silent then
			fire(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end
	minus.MouseButton1Click:Connect(function()
		obj:Set(value - step)
	end)
	plus.MouseButton1Click:Connect(function()
		obj:Set(value + step)
	end)

	w:_flag(o.Flag, obj)
	task.defer(fire, o.Callback, value)
	return finish(obj, el)
end

