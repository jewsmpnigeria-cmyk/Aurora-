	return tab
end

--// Ready-made config tab -------------------------------------------------------
function Window:CreateConfigTab(name, icon)
	local tab = self:CreateTab(name or "Configs", icon, "Save and load your settings")
	if not self:CanSaveFiles() then
		tab:CreateParagraph({
			Title = "Saving unavailable",
			Content = "This environment can't write files. Use Window:GetConfig() / LoadConfig() to store settings yourself.",
		})
		return tab
	end

	local cfgName = "default"
	local selected
	tab:CreateSection("Save")
	tab:CreateInput({
		Name = "Config name",
		Default = "default",
		Placeholder = "name",
		Callback = function(t)
			if t ~= "" then
				cfgName = t
			end
		end,
	})
	local list
	tab:CreateButton({
		Name = "Save config",
		Primary = true,
		Callback = function()
			local ok, err = self:SaveConfig(cfgName)
			self:Notify({
				Title = ok and "Config saved" or "Save failed",
				Content = ok and cfgName or tostring(err),
			})
			if ok and list then
				list:Refresh(self:ListConfigs(), true)
			end
		end,
	})

	tab:CreateSection("Load")
	list = tab:CreateDropdown({
		Name = "Saved configs",
		Options = self:ListConfigs(),
		Callback = function(n)
			selected = n
		end,
	})
	tab:CreateButton({
		Name = "Load selected",
		Callback = function()
			if not selected then
				self:Notify({ Title = "Pick a config first" })
				return
			end
			local ok, err = self:LoadConfigFile(selected)
			self:Notify({
				Title = ok and "Config loaded" or "Load failed",
				Content = ok and selected or tostring(err),
			})
		end,
	})
	tab:CreateButton({
		Name = "Refresh list",
		Callback = function()
			list:Refresh(self:ListConfigs(), true)
		end,
	})
	return tab
end

return Aurora
