function Tab:CreateKeybind(o)
	local w = self.Window
	o = o or {}
	local hh = self:_height(o)
	local el = self:_element(hh)
	self:_head(el, o, 120)

	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = rightPos(hh, 14),
		Size = UDim2.fromOffset(92, 30),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		TextSize = 12,
		Font = Enum.Font.GothamMedium,
		Parent = el,
	})
	w:_bind(btn, "BackgroundColor3", "Background")
	w:_bind(btn, "TextColor3", "Text")
	corner(btn, 8)
	w:_stroke(btn)

	local key = o.Default or Enum.KeyCode.Unknown
	local listening = false
	local function show()
		btn.Text = KEYNAMES[key.Name] or key.Name
	end
	show()

	btn.MouseButton1Click:Connect(function()
		listening = true
		btn.Text = "..."
	end)

	w:_connect(UserInputService.InputBegan, function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				key = input.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or input.KeyCode
				show()
				fire(o.Changed, key)
			end
		elseif not gp and key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
			fire(o.Callback, key)
		end
	end)

	local obj = { Type = "Keybind" }
	function obj:Get()
		return key
	end
	function obj:Set(k, silent)
		key = k or Enum.KeyCode.Unknown
		show()
		if not silent then
			fire(o.Changed, key)
		end
	end
	w:_flag(o.Flag, obj)
	return finish(obj, el)
end

