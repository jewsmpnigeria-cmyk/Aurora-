function Window:GetFlag(name)
	local o = self.Flags[name]
	return o and o:Get()
end

function Window:GetConfig()
	local cfg = {}
	for name, obj in pairs(self.Flags) do
		local v = obj:Get()
		if typeof(v) == "Color3" then
			v = { __color = { v.R, v.G, v.B } }
		elseif typeof(v) == "EnumItem" then
			v = { __key = v.Name }
		end
		cfg[name] = v
	end
	return cfg
end

function Window:LoadConfig(cfg)
	for name, v in pairs(cfg) do
		local obj = self.Flags[name]
		if obj then
			if type(v) == "table" and v.__color then
				v = Color3.new(table.unpack(v.__color))
			elseif type(v) == "table" and v.__key then
				v = Enum.KeyCode[v.__key]
			end
			obj:Set(v)
		end
	end
end

--// File configs (only work where writefile/readfile exist, e.g. executors) --------
local function cleanName(name)
	return (tostring(name or "default"):gsub("[^%w_%- ]", "_"))
end

function Window:CanSaveFiles()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

function Window:SaveConfig(name)
	if not self:CanSaveFiles() then
		return false, "This environment has no file functions (writefile/readfile)."
	end
	local ok, err = pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" then
			local path = ""
			for part in string.gmatch(self._configFolder, "[^/]+") do
				path = path == "" and part or (path .. "/" .. part)
				if not isfolder(path) then
					makefolder(path)
				end
			end
		end
		writefile(self._configFolder .. "/" .. cleanName(name) .. ".json", HttpService:JSONEncode(self:GetConfig()))
	end)
	return ok, ok and nil or tostring(err)
end

function Window:LoadConfigFile(name)
	if not self:CanSaveFiles() then
		return false, "This environment has no file functions (writefile/readfile)."
	end
	local path = self._configFolder .. "/" .. cleanName(name) .. ".json"
	if not isfile(path) then
		return false, "Config not found: " .. cleanName(name)
	end
	local ok, err = pcall(function()
		self:LoadConfig(HttpService:JSONDecode(readfile(path)))
	end)
	return ok, ok and nil or tostring(err)
end

function Window:ListConfigs()
	local out = {}
	if type(listfiles) ~= "function" or type(isfolder) ~= "function" or not isfolder(self._configFolder) then
		return out
	end
	local ok, files = pcall(listfiles, self._configFolder)
	if ok then
		for _, f in ipairs(files) do
			local n = tostring(f):match("([^/\\]+)%.json$")
			if n then
				table.insert(out, n)
			end
		end
	end
	table.sort(out)
	return out
end

--// Tabs -----------------------------------------------------------------------
function Window:SelectTab(tab)
	for _, t in ipairs(self.Tabs) do
		t:_setActive(t == tab)
	end
end

-- CreateTab("Name", icon?, "Description"?)  or  CreateTab({Name=, Icon=, Description=})
function Window:CreateTab(name, icon, description)
	if type(name) == "table" then
		icon, description, name = name.Icon, name.Description, name.Name
	end
	name = tostring(name or "Tab")

	local w = self
	local tab = setmetatable({ Window = w, Name = name, Description = description, _order = 0, _active = false }, Tab)

	local btn = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		LayoutOrder = #w.Tabs + 1,
		Parent = w._tabList,
	})
	w:_bind(btn, "BackgroundColor3", "Element")
	corner(btn, 10)
	local tstroke = w:_stroke(btn)
	tstroke.Transparency = 1

	local indicator = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -10, 0.5, 0),
		Size = UDim2.fromOffset(3, 0),
		BorderSizePixel = 0,
		Parent = btn,
	})
	w:_bind(indicator, "BackgroundColor3", "Accent")
	corner(indicator, 100)

	local iconObj, iconProp
	local labelX = 16
	if icon then
		iconObj, iconProp = makeIcon(icon, 18, btn)
		iconObj.AnchorPoint = Vector2.new(0, 0.5)
		iconObj.Position = UDim2.new(0, 14, 0.5, 0)
		iconObj[iconProp] = w.Theme.SubText
		labelX = 42
	end

	local label = create("TextLabel", {
		Position = UDim2.fromOffset(labelX, 0),
		Size = UDim2.new(1, -(labelX + 8), 1, 0),
		BackgroundTransparency = 1,
		Text = name,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = w.Theme.SubText,
		Parent = btn,
	})

	local page = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = w._content,
	})
	w:_bind(page, "ScrollBarImageColor3", "Accent")
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
	pad(page, 4, 20, 16, 24)

	tab.Button, tab.Label, tab.Indicator, tab.Page = btn, label, indicator, page

	function tab:_render(t)
		local th = w.Theme
		tween(label, { TextColor3 = self._active and th.Text or th.SubText }, t)
		if iconObj then
			tween(iconObj, { [iconProp] = self._active and th.Accent or th.SubText }, t)
		end
		tween(btn, { BackgroundTransparency = self._active and 0 or 1 }, t)
		tween(tstroke, { Transparency = self._active and 0 or 1 }, t)
		tween(indicator, { Size = UDim2.fromOffset(3, self._active and 18 or 0) }, t)
	end

	function tab:_setActive(active)
		local changed = self._active ~= active
		self._active = active
		page.Visible = active
		if active then
			w._title.Text = self.Name
			w._subtitle.Text = self.Description or ""
			if changed then
				page.Position = UDim2.fromOffset(0, 14)
				tween(page, { Position = UDim2.fromOffset(0, 0) }, 0.35)
			end
		end
		self:_render(0.2)
	end

	w:_onTheme(btn, function()
		tab:_render(0.3)
	end)

	btn.MouseEnter:Connect(function()
		if not tab._active then
			tween(label, { TextColor3 = w.Theme.Text }, 0.15)
		end
	end)
	btn.MouseLeave:Connect(function()
		tab:_render(0.15)
	end)
	btn.MouseButton1Click:Connect(function()
		w:SelectTab(tab)
	end)

	table.insert(w.Tabs, tab)
	if #w.Tabs == 1 then
		w:SelectTab(tab)
	end
	return tab
end

--// Element base ---------------------------------------------------------------
function Tab:_element(height, bgKey)
	local w = self.Window
	bgKey = bgKey or "Element"
	self._order = self._order + 1
	local f = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BorderSizePixel = 0,
		LayoutOrder = self._order,
		Parent = self.Page,
	})
	w:_bind(f, "BackgroundColor3", bgKey)
	corner(f, 10)
	w:_stroke(f, bgKey == "Accent" and "Accent" or "Stroke")
	return f
end

function Tab:_height(o)
	return o.Description and 64 or 48
end

-- Optional icon + title + description. reserve = pixels kept free on the right.
function Tab:_head(el, o, reserve, nameKey, descKey)
	local w = self.Window
	local hh = self:_height(o)
	local hasDesc = o.Description ~= nil
	local x = 16
	if o.Icon then
		local ic, prop = makeIcon(o.Icon, 18, el)
		ic.AnchorPoint = Vector2.new(0, 0.5)
		ic.Position = UDim2.new(0, 16, 0, hh / 2)
		w:_bind(ic, prop, nameKey == "AccentText" and "AccentText" or "Accent")
		x = 48
	end
	local name = w:_text(el, o.Name or "", 14, nameKey or "Text")
	name.Position = UDim2.fromOffset(x, hasDesc and 13 or 0)
	name.Size = UDim2.new(1, -(x + reserve), 0, hasDesc and 18 or hh)
	name.TextTruncate = Enum.TextTruncate.AtEnd
	local desc
	if hasDesc then
		desc = w:_text(el, o.Description, 12, descKey or "SubText")
		desc.Position = UDim2.fromOffset(x, 33)
		desc.Size = UDim2.new(1, -(x + reserve), 0, 14)
		desc.TextTruncate = Enum.TextTruncate.AtEnd
	end
	return name, desc
end

local function rightPos(hh, dx)
	return UDim2.new(1, -dx, 0, hh / 2)
end

