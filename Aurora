--// Dropdown -------------------------------------------------------------------
function Tab:CreateDropdown(o)
	local w = self.Window
	o = o or {}
	local multi = o.Multi == true

	local function normalize(list)
		local t = {}
		for _, v in ipairs(list or {}) do
			table.insert(t, tostring(v))
		end
		return t
	end
	local options = normalize(o.Options)

	local hh = self:_height(o)
	local el = self:_element(hh)
	el.ClipsDescendants = true
	self:_head(el, o, 210)

	local value = w:_text(el, "", 13, "SubText")
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, -38, 0, 0)
	value.Size = UDim2.new(0.45, -40, 0, hh)
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.TextTruncate = Enum.TextTruncate.AtEnd

	local arrow = w:_text(el, "▾", 14, "SubText")
	arrow.AnchorPoint = Vector2.new(1, 0)
	arrow.Position = UDim2.new(1, -14, 0, 0)
	arrow.Size = UDim2.fromOffset(16, hh)
	arrow.TextXAlignment = Enum.TextXAlignment.Center

	local list = create("ScrollingFrame", {
		Position = UDim2.fromOffset(8, hh + 4),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = el,
	})
	w:_bind(list, "ScrollBarImageColor3", "Accent")
	create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local hit = w:_hit(el)
	hit.Size = UDim2.new(1, 0, 0, hh)
	w:_hover(el, hit)

	local selected = {}
	local buttons = {}
	local open = false

	local function listH()
		return math.min(#options * 31, 150)
	end

	local function renderValue()
		local arr = {}
		for _, opt in ipairs(options) do
			if selected[opt] then
				table.insert(arr, opt)
			end
		end
		if multi then
			value.Text = #arr == 0 and "None" or table.concat(arr, ", ")
		else
			value.Text = arr[1] or "None"
		end
		return arr
	end

	local function renderButtons(t)
		for opt, b in pairs(buttons) do
			local on = selected[opt] == true
			tween(b, {
				TextColor3 = on and w.Theme.Accent or w.Theme.SubText,
				BackgroundTransparency = on and 0 or 1,
			}, t)
		end
	end
	w:_onTheme(el, function()
		renderButtons(0.3)
	end)

	local function setOpen(v)
		open = v
		list.Size = UDim2.new(1, -16, 0, listH())
		tween(el, { Size = UDim2.new(1, 0, 0, v and (hh + 4 + listH() + 8) or hh) }, 0.25)
		tween(arrow, { Rotation = v and 180 or 0 }, 0.25)
	end

	local function emit()
		local arr = renderValue()
		fire(o.Callback, multi and arr or arr[1])
	end

	local function toggleOption(opt)
		if multi then
			selected[opt] = (not selected[opt]) or nil
		else
			selected = { [opt] = true }
			setOpen(false)
		end
		renderValue()
		renderButtons(0.15)
		emit()
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}
		for i, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				Text = opt,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				BackgroundTransparency = 1,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = i,
				Parent = list,
			})
			w:_bind(b, "BackgroundColor3", "ElementHover")
			corner(b, 6)
			pad(b, 0, 8, 0, 10)
			buttons[opt] = b
			b.MouseButton1Click:Connect(function()
				toggleOption(opt)
			end)
		end
		list.Size = UDim2.new(1, -16, 0, listH())
		renderButtons(0)
	end

	if multi then
		if type(o.Default) == "table" then
			for _, d in ipairs(o.Default) do
				selected[tostring(d)] = true
			end
		end
	elseif o.Default ~= nil then
		selected[tostring(o.Default)] = true
	end

	build()
	renderValue()

	hit.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	local obj = { Type = "Dropdown" }
	function obj:Get()
		local arr = renderValue()
		return multi and arr or arr[1]
	end
	function obj:Set(v, silent)
		selected = {}
		if multi then
			for _, d in ipairs(type(v) == "table" and v or {}) do
				if table.find(options, tostring(d)) then
					selected[tostring(d)] = true
				end
			end
		elseif v ~= nil and table.find(options, tostring(v)) then
			selected[tostring(v)] = true
		end
		renderValue()
		renderButtons(0.15)
		if not silent then
			emit()
		end
	end
	function obj:Refresh(newOptions, keepSelection)
		options = normalize(newOptions)
		local kept = {}
		if keepSelection then
			for opt in pairs(selected) do
				if table.find(options, opt) then
					kept[opt] = true
				end
			end
		end
		selected = kept
		build()
		renderValue()
		if open then
			setOpen(true)
		end
	end

	w:_flag(o.Flag, obj)
	if next(selected) ~= nil then
		task.defer(function()
			local arr = renderValue()
			fire(o.Callback, multi and arr or arr[1])
		end)
	end
	return finish(obj, el)
end

