--// Dropdown -------------------------------------------------------------------
function Tab:CreateDropdown(o)
	local w = self.Window
	o = o or {}
	local multi = o.Multi == true

	local function normalize(list)
		local t = {}
		for _, v in ipairs(list or {}) do
			table.insert(t, tostring(v))
		end
		return t
	end
	local options = normalize(o.Options)

	local el = self:_element(38)
	el.ClipsDescendants = true
	nameLabel(w, el, o.Name or "Dropdown", 190)

	local value = w:_text(el, "", 13, "SubText")
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, -34, 0, 0)
	value.Size = UDim2.new(0.5, -40, 0, 38)
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.TextTruncate = Enum.TextTruncate.AtEnd

	local arrow = w:_text(el, "▾", 14, "SubText")
	arrow.AnchorPoint = Vector2.new(1, 0)
	arrow.Position = UDim2.new(1, -12, 0, 0)
	arrow.Size = UDim2.fromOffset(16, 38)
	arrow.TextXAlignment = Enum.TextXAlignment.Center

	local list = create("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 44),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = el,
	})
	w:_bind(list, "ScrollBarImageColor3", "Accent")
	create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local hit = w:_hit(el)
	hit.Size = UDim2.new(1, 0, 0, 38)
	w:_hover(el, hit)

	local selected = {}
	local buttons = {}
	local open = false

	local function listH()
		return math.min(#options * 31, 150)
	end

	local function renderValue()
		local arr = {}
		for _, opt in ipairs(options) do
			if selected[opt] then
				table.insert(arr, opt)
			end
		end
		if multi then
			value.Text = #arr == 0 and "None" or table.concat(arr, ", ")
		else
			value.Text = arr[1] or "None"
		end
		return arr
	end

	local function renderButtons(t)
		for opt, b in pairs(buttons) do
			local on = selected[opt] == true
			tween(b, {
				TextColor3 = on and w.Theme.Accent or w.Theme.SubText,
				BackgroundTransparency = on and 0 or 1,
			}, t)
		end
	end
	w:_onTheme(el, function()
		renderButtons(0.3)
	end)

	local function setOpen(v)
		open = v
		list.Size = UDim2.new(1, -16, 0, listH())
		tween(el, { Size = UDim2.new(1, 0, 0, v and (44 + listH() + 8) or 38) }, 0.25)
		tween(arrow, { Rotation = v and 180 or 0 }, 0.25)
	end

	local function emit()
		local arr = renderValue()
		fire(o.Callback, multi and arr or arr[1])
	end

	local function toggleOption(opt)
		if multi then
			selected[opt] = (not selected[opt]) or nil
		else
			selected = { [opt] = true }
			setOpen(false)
		end
		renderValue()
		renderButtons(0.15)
		emit()
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}
		for i, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				Text = opt,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				BackgroundTransparency = 1,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = i,
				Parent = list,
			})
			w:_bind(b, "BackgroundColor3", "ElementHover")
			corner(b, 6)
			pad(b, 0, 8, 0, 10)
			buttons[opt] = b
			b.MouseButton1Click:Connect(function()
				toggleOption(opt)
			end)
		end
		list.Size = UDim2.new(1, -16, 0, listH())
		renderButtons(0)
	end

	if multi then
		if type(o.Default) == "table" then
			for _, d in ipairs(o.Default) do
				selected[tostring(d)] = true
			end
		end
	elseif o.Default ~= nil then
		selected[tostring(o.Default)] = true
	end

	build()
	renderValue()

	hit.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	local obj = { Type = "Dropdown" }
	function obj:Get()
		local arr = renderValue()
		return multi and arr or arr[1]
	end
	function obj:Set(v, silent)
		selected = {}
		if multi then
			for _, d in ipairs(type(v) == "table" and v or {}) do
				if table.find(options, tostring(d)) then
					selected[tostring(d)] = true
				end
			end
		elseif v ~= nil and table.find(options, tostring(v)) then
			selected[tostring(v)] = true
		end
		renderValue()
		renderButtons(0.15)
		if not silent then
			emit()
		end
	end
	function obj:Refresh(newOptions, keepSelection)
		options = normalize(newOptions)
		local kept = {}
		if keepSelection then
			for opt in pairs(selected) do
				if table.find(options, opt) then
					kept[opt] = true
				end
			end
		end
		selected = kept
		build()
		renderValue()
		if open then
			setOpen(true)
		end
	end

	w:_flag(o.Flag, obj)
	if next(selected) ~= nil then
		task.defer(function()
			local arr = renderValue()
			fire(o.Callback, multi and arr or arr[1])
		end)
	end
	return finish(obj, el)
end

--// Keybind --------------------------------------------------------------------
function Tab:CreateKeybind(o)
	local w = self.Window
	o = o or {}
	local el = self:_element(38)
	nameLabel(w, el, o.Name or "Keybind", 110)

	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(86, 26),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		Parent = el,
	})
	w:_bind(btn, "BackgroundColor3", "Background")
	w:_bind(btn, "TextColor3", "Accent")
	corner(btn, 6)
	w:_stroke(btn)

	local key = o.Default or Enum.KeyCode.Unknown
	local listening = false
	local function show()
		btn.Text = key == Enum.KeyCode.Unknown and "None" or key.Name
	end
	show()

	btn.MouseButton1Click:Connect(function()
		listening = true
		btn.Text = "..."
	end)

	w:_connect(UserInputService.InputBegan, function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				key = input.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or input.KeyCode
				show()
				fire(o.Changed, key)
			end
		elseif not gp and key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
			fire(o.Callback, key)
		end
	end)

	local obj = { Type = "Keybind" }
	function obj:Get()
		return key
	end
	function obj:Set(k, silent)
		key = k or Enum.KeyCode.Unknown
		show()
		if not silent then
			fire(o.Changed, key)
		end
	end
	w:_flag(o.Flag, obj)
	return finish(obj, el)
end

--// Color Picker ---------------------------------------------------------------
function Tab:CreateColorPicker(o)
	local w = self.Window
	o = o or {}
	local color = o.Default or Color3.fromRGB(255, 255, 255)
	local h, s, v = color:ToHSV()

	local el = self:_element(38)
	el.ClipsDescendants = true
	nameLabel(w, el, o.Name or "Color", 70)

	local swatch = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0, 19),
		Size = UDim2.fromOffset(34, 18),
		BorderSizePixel = 0,
		Parent = el,
	})
	corner(swatch, 5)
	w:_stroke(swatch)

	local headHit = w:_hit(el)
	headHit.Size = UDim2.new(1, 0, 0, 38)
	w:_hover(el, headHit)

	-- Saturation / value box
	local svBox = create("Frame", {
		Position = UDim2.fromOffset(12, 46),
		Size = UDim2.new(1, -24, 0, 100),
		BorderSizePixel = 0,
		Parent = el,
	})
	corner(svBox, 6)
	local white = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = svBox,
	})
	corner(white, 6)
	create("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
	local black = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = svBox,
	})
	corner(black, 6)
	create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
	local svKnob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = svBox,
	})
	corner(svKnob, 100)
	create("UIStroke", { Thickness = 2, Color = Color3.new(0, 0, 0), Parent = svKnob })
	local svHit = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = svBox,
	})

	-- Hue bar
	local hueBar = create("Frame", {
		Position = UDim2.fromOffset(12, 154),
		Size = UDim2.new(1, -24, 0, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = el,
	})
	corner(hueBar, 100)
	local kps = {}
	for i = 0, 6 do
		table.insert(kps, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((i / 6) % 1, 1, 1)))
	end
	create("UIGradient", { Color = ColorSequence.new(kps), Parent = hueBar })
	local hueKnob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(8, 18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = hueBar,
	})
	corner(hueKnob, 4)
	create("UIStroke", { Thickness = 2, Color = Color3.new(0, 0, 0), Parent = hueKnob })
	local hueHit = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = hueBar,
	})

	local function paint()
		swatch.BackgroundColor3 = color
		svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svKnob.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
	end
	paint()

	local mode
	local function update(pos)
		if mode == "sv" then
			s = math.clamp((pos.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
			v = 1 - math.clamp((pos.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
		elseif mode == "hue" then
			h = math.clamp((pos.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 0.999)
		end
		color = Color3.fromHSV(h, s, v)
		paint()
		fire(o.Callback, color)
	end
	svHit.InputBegan:Connect(function(input)
		if isPress(input) then
			mode = "sv"
			update(input.Position)
		end
	end)
	hueHit.InputBegan:Connect(function(input)
		if isPress(input) then
			mode = "hue"
			update(input.Position)
		end
	end)
	w:_connect(UserInputService.InputChanged, function(input)
		if mode and isMove(input) then
			update(input.Position)
		end
	end)
	w:_connect(UserInputService.InputEnded, function(input)
		if mode and isPress(input) then
			mode = nil
		end
	end)

	local open = false
	headHit.MouseButton1Click:Connect(function()
		open = not open
		tween(el, { Size = UDim2.new(1, 0, 0, open and 176 or 38) }, 0.25)
	end)

	local obj = { Type = "ColorPicker" }
	function obj:Get()
		return color
	end
	function obj:Set(c, silent)
		color = c
		h, s, v = c:ToHSV()
		paint()
		if not silent then
			fire(o.Callback, color)
		end
	end
	w:_flag(o.Flag, obj)
	task.defer(fire, o.Callback, color)
	return finish(obj, el)
end

--// Players --------------------------------------------------------------------
function Tab:CreatePlayerCard(o)
	local w = self.Window
	o = o or {}
	local el = self:_element(76)

	local avatar = create("ImageLabel", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(52, 52),
		BorderSizePixel = 0,
		Image = "",
		Parent = el,
	})
	w:_bind(avatar, "BackgroundColor3", "ElementHover")
	corner(avatar, 100)

	local nameL = w:_text(el, "No player", 15, "Text", Enum.Font.GothamBold)
	nameL.Position = UDim2.fromOffset(76, 11)
	nameL.Size = UDim2.new(1, -88, 0, 18)
	local userL = w:_text(el, "", 12, "Accent")
	userL.Position = UDim2.fromOffset(76, 30)
	userL.Size = UDim2.new(1, -88, 0, 14)
	local infoL = w:_text(el, "", 12, "SubText")
	infoL.Position = UDim2.fromOffset(76, 47)
	infoL.Size = UDim2.new(1, -88, 0, 14)

	local current
	local obj = { Type = "PlayerCard" }
	function obj:SetPlayer(plr)
		current = plr
		if not plr then
			nameL.Text, userL.Text, infoL.Text = "No player", "", ""
			avatar.Image = ""
			return
		end
		nameL.Text = plr.DisplayName
		userL.Text = "@" .. plr.Name
		infoL.Text = string.format("ID: %d  •  Account age: %d days", plr.UserId, plr.AccountAge)
		task.spawn(function()
			local ok, img = pcall(
				Players.GetUserThumbnailAsync,
				Players,
				plr.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)
			if ok and avatar.Parent and current == plr then
				avatar.Image = img
			end
		end)
	end
	function obj:Get()
		return current
	end

	obj:SetPlayer(o.Player)
	return finish(obj, el)
end

function Tab:CreatePlayerDropdown(o)
	local w = self.Window
	o = o or {}
	local function names()
		local t = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if o.IncludeLocalPlayer ~= false or p ~= Players.LocalPlayer then
				table.insert(t, p.Name)
			end
		end
		table.sort(t)
		return t
	end

	local dd = self:CreateDropdown({
		Name = o.Name or "Player",
		Options = names(),
		Flag = o.Flag,
		Callback = function(n)
			fire(o.Callback, n and Players:FindFirstChild(n) or nil)
		end,
	})

	local function refresh()
		dd:Refresh(names(), true)
	end
	w:_connect(Players.PlayerAdded, function()
		task.delay(0.1, refresh)
	end)
	w:_connect(Players.PlayerRemoving, function()
		task.delay(0.2, refresh)
	end)

	function dd:GetPlayer()
		local n = dd:Get()
		return n and Players:FindFirstChild(n) or nil
	end
	return dd
end

--// Ready-made settings tab ------------------------------------------------------
function Window:CreateSettingsTab(name)
	local tab = self:CreateTab(name or "Settings", "⚙")

	tab:CreateSection("Appearance")
	local names = {}
	for n in pairs(Aurora.Themes) do
		table.insert(names, n)
	end
	table.sort(names)
	tab:CreateDropdown({
		Name = "Theme",
		Options = names,
		Default = self.ThemeName ~= "Custom" and self.ThemeName or nil,
		Callback = function(n)
			if n and n ~= self.ThemeName then
				self:SetTheme(n)
			end
		end,
	})
	tab:CreateColorPicker({
		Name = "Accent Color",
		Default = self.Theme.Accent,
		Callback = function(c)
			if c ~= self.Theme.Accent then
				self:SetAccent(c)
			end
		end,
	})

	tab:CreateSection("Interface")
	tab:CreateKeybind({
		Name = "Toggle UI Key",
		Default = self._toggleKey,
		Changed = function(k)
			self._toggleKey = k
		end,
	})
	tab:CreateButton({
		Name = "Destroy UI",
		Callback = function()
			self:Destroy()
		end,
	})
	return tab
end

--// Ready-made config tab -------------------------------------------------------
function Window:CreateConfigTab(name)
	local tab = self:CreateTab(name or "Configs", "💾")
	if not self:CanSaveFiles() then
		tab:CreateParagraph({
			Title = "Saving unavailable",
			Content = "This environment can't write files. Use Window:GetConfig() / LoadConfig() to store settings yourself.",
		})
		return tab
	end

	local cfgName = "default"
	local selected
	tab:CreateSection("Save")
	tab:CreateInput({
		Name = "Config name",
		Default = "default",
		Placeholder = "name",
		Callback = function(t)
			if t ~= "" then
				cfgName = t
			end
		end,
	})
	local list
	tab:CreateButton({
		Name = "Save config",
		Callback = function()
			local ok, err = self:SaveConfig(cfgName)
			self:Notify({
				Title = ok and "Config saved" or "Save failed",
				Content = ok and cfgName or tostring(err),
			})
			if ok and list then
				list:Refresh(self:ListConfigs(), true)
			end
		end,
	})

	tab:CreateSection("Load")
	list = tab:CreateDropdown({
		Name = "Saved configs",
		Options = self:ListConfigs(),
		Callback = function(n)
			selected = n
		end,
	})
	tab:CreateButton({
		Name = "Load selected",
		Callback = function()
			if not selected then
				self:Notify({ Title = "Pick a config first" })
				return
			end
			local ok, err = self:LoadConfigFile(selected)
			self:Notify({
				Title = ok and "Config loaded" or "Load failed",
				Content = ok and selected or tostring(err),
			})
		end,
	})
	tab:CreateButton({
		Name = "Refresh list",
		Callback = function()
			list:Refresh(self:ListConfigs(), true)
		end,
	})
	return tab
end

return Aurora
